{
  "admin": {
    "listen": "__ADMIN_LISTEN__",
    "origins": __ADMIN_ORIGINS__,
    "config": { "persist": true }
  },
  "logging": {
    "logs": {
      "default": { "level": "INFO", "writer": { "output": "stdout" }, "encoder": { "format": "json" } }
    }
  },
  "apps": {
    "http": {
      "grace_period": "10s",
      "servers": {
        "levant": {
          "listen": __LISTEN__,
          "protocols": ["h1", "h2", "h3"],
          "automatic_https": __AUTO_HTTPS__,
          "routes": [
            {
              "@id": "ld-dashboard",
              "match": [{ "host": ["__DASHBOARD_HOST__"] }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "__CONTROL_UPSTREAM__" }],
                  "flush_interval": -1,
                  "headers": { "request": { "set": { "X-Forwarded-Host": ["{http.request.host}"] } } }
                }
              ],
              "terminal": true
            },
            {
              "@id": "ld-fallback",
              "handle": [
                { "handler": "rewrite", "uri": "/index.html" },
                { "handler": "headers", "response": { "set": { "Cache-Control": ["no-store"], "X-Levant": ["no-route"] } } },
                { "handler": "file_server", "root": "/srv/levant", "status_code": 404 }
              ],
              "terminal": true
            }
          ],
          "logs": {}
        }
      }
    },
    "tls": {
      __TLS_CERTS__
      "automation": {
        "policies": __TLS_POLICIES__,
        "on_demand": {
          "permission": { "module": "http", "endpoint": "__TLS_ASK__" }
        }
      }
    }
  }
}
