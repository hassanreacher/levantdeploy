# ─── LevantDeploy production configuration (/opt/levantdeploy/.env) ─────────
# install/install.sh writes this file for you. To set it up by hand:
#   cp install/env.example .env && chmod 600 .env
#   generate every secret with: openssl rand -hex 32
#   docker compose up -d --build
# Never commit this file. Keep a copy of ENCRYPTION_KEY somewhere safe: without it, stored env vars and
# database credentials cannot be decrypted (backups made by install/backup.sh include it).

COMPOSE_PROJECT_NAME=levantdeploy

# Apps are served at {project}.PLATFORM_DOMAIN and {project}-{id}.PLATFORM_DOMAIN → wildcard DNS *.PLATFORM_DOMAIN
PLATFORM_DOMAIN=example.com
# Dashboard + API host (A record → this server)
DASHBOARD_HOST=deploy.example.com
PLATFORM_SCHEME=https
APP_URL=https://deploy.example.com

# TLS: acme (Let's Encrypt / ZeroSSL, on demand) | internal (Caddy local CA, testing) | off (plain HTTP)
TLS_MODE=acme
ACME_EMAIL=you@example.com
# Host ports of the edge proxy
HTTP_PORT=80
HTTPS_PORT=443
# Public IP(s) of this server, comma separated (DNS instructions + domain verification)
SERVER_IPS=203.0.113.10

# Secrets (openssl rand -hex 24 / 32)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ENCRYPTION_KEY=
SESSION_SECRET=

# Paths / Docker
LEVANT_DATA_DIR=/var/lib/levantdeploy
LEVANT_INSTALL_DIR=/opt/levantdeploy
# group id of /var/run/docker.sock on the host: stat -c %g /var/run/docker.sock
DOCKER_GID=999
# network every app container joins (fixed name)
DOCKER_NETWORK=levant_net

# Registration after the first (owner) account: invite | open  (also editable in Settings → General)
REGISTRATION=invite
# Schema sync at start: auto (migrations + non-destructive db push) | migrate | push
LEVANT_DB_SYNC=auto
# Optional: version file for "update available" (also editable in Settings → Updates)
# LEVANT_UPDATE_URL=https://api.github.com/repos/<owner>/levantdeploy/releases/latest
# Optional: use prebuilt images instead of building from source
# LEVANT_PULL=1
# LEVANT_IMAGE=ghcr.io/<owner>/levantdeploy-control
# LEVANT_CADDY_IMAGE=ghcr.io/<owner>/levantdeploy-caddy
# LEVANT_VERSION=0.1.0

WORKER_CONCURRENCY=2

# ── LevantBase (backend projects: Postgres + Auth + REST + Realtime + Storage + Functions + Studio) ──
# Backends are served at {ref}.BASE_DOMAIN and studio-{ref}.BASE_DOMAIN → wildcard DNS *.BASE_DOMAIN
BASE_DOMAIN=base.example.com
# Registry mirror for the backend images (e.g. mirror.gcr.io when Docker Hub rate-limits you); empty = Docker Hub
BASE_IMAGE_MIRROR=
# Outbound proxy for backends (auth emails/OAuth, edge-function imports) on servers behind a proxy; empty = direct
BASE_EGRESS_PROXY=
# CA bundle for that proxy — must be a file inside LEVANT_DATA_DIR (installer: --base-egress-ca copies it there)
BASE_EGRESS_CA_FILE=
# Host ports for optional public Postgres connections per backend (plan-gated)
BASE_DB_PORT_RANGE=54000-54999
# 1 = the installer opens BASE_DB_PORT_RANGE in ufw (--base-db-ports)
BASE_DB_PUBLIC_PORTS=0

# DNS resolvers used to verify custom domains
DNS_RESOLVERS=1.1.1.1,8.8.8.8

# Edge proxy wiring (defaults are right for docker-compose.yml — change only for custom setups)
# PROXY_TLS is taken from TLS_MODE; CADDY_LOG_DIR=/var/log/caddy (inside Caddy) and
# CADDY_ACCESS_LOG=/var/log/levant-caddy/access.log (worker side, shared volume caddy_logs) are fixed in compose.
# CONTROL_UPSTREAM=control:3000
# CADDY_ADMIN_URL=http://caddy-admin:2019
# CADDY_ADMIN_LISTEN=caddy-admin:2019

# ── AI providers (AI Builder + agent) — optional ──
# Normally configured in Settings → AI providers (stored encrypted). Values here are used as a fallback.
# Leave empty unless you want to manage keys in this file. Never commit real keys.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OLLAMA_API_KEY=
UNOROUTER_API_KEY=
ORCAROUTER_API_KEY=
KILO_API_KEY=
POLLINATIONS_KEY=
LLM7_API_KEY=
LOGFARE_API_KEY=
OVH_AI_ENDPOINTS_TOKEN=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ── AI Builder ──
BUILDER_RUNTIME_IMAGE=levant/builder-runtime:next15
# on | off (off removes the preview-*.PLATFORM_DOMAIN route)
BUILDER_PREVIEWS=on
BUILDER_PREVIEW_IDLE_MIN=20
BUILDER_PREVIEW_MEMORY_MB=2048
# outbound proxy for preview containers (falls back to BASE_EGRESS_*); CA file must be inside LEVANT_DATA_DIR
BUILDER_EGRESS_PROXY=
BUILDER_EGRESS_NO_PROXY=
BUILDER_EGRESS_CA_FILE=
# proxy/CA/Node mirror used when the installer/update.sh build the platform's own images (installer --build-* flags)
# LEVANT_BUILD_PROXY=
# LEVANT_BUILD_CA_FILE=
# LEVANT_BUILD_NODE_IMAGE=

# Optional: SMTP (or configure it in Settings → Email)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="LevantDeploy <no-reply@example.com>"
