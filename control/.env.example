# ─── LevantDeploy control plane (copy to .env) ───────────────────────────────
# Never commit real values. Generate secrets with: openssl rand -base64 48

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/levantdeploy
REDIS_URL=redis://localhost:6379

# AES-256-GCM key material for env vars / DB credentials / TOTP secrets (32+ random chars).
# Changing it makes existing encrypted values unreadable.
ENCRYPTION_KEY=change-me-32-plus-random-characters-here
# JWT signing secret for sessions (32+ random chars)
SESSION_SECRET=change-me-another-32-plus-random-characters

# Apps are served at {project}.PLATFORM_DOMAIN and {project}-{id}.PLATFORM_DOMAIN (wildcard DNS → this server)
PLATFORM_DOMAIN=levant.localhost
# http for local dev, https in production (Caddy terminates TLS)
PLATFORM_SCHEME=http
# Host (and port) of the dashboard, and its public URL
DASHBOARD_HOST=localhost:3000
APP_URL=http://localhost:3000

# Files: logs archives, uploads, backups (STORAGE_DIR) and build workspaces (WORK_DIR)
STORAGE_DIR=./storage
WORK_DIR=./storage/work

DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=levant_net
CADDY_ADMIN_URL=http://localhost:2019

# Registration after the first (owner) account: invite | open
REGISTRATION=invite

# Worker
WORKER_CONCURRENCY=2
# WORKER_CONCURRENCY_BUILD=2
# WORKER_CONCURRENCY_DEPLOY=4

# AI agent (optional)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# SMTP (optional — without SMTP_HOST, emails such as password reset links are printed to the server log)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="LevantDeploy <no-reply@example.com>"

# GitHub App (optional; usually created via the manifest flow and stored in settings)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# Edge proxy (runtime area; production values are set by the root docker-compose.yml)
# CONTROL_UPSTREAM=host.docker.internal:3000
# PROXY_TLS=internal
# ACME_EMAIL=
# CADDY_ADMIN_LISTEN=0.0.0.0:2019
# CADDY_LOG_DIR=/var/log/caddy
# CADDY_ACCESS_LOG=./storage/caddy/access.log
# SERVER_IPS=
# DNS_RESOLVERS=1.1.1.1,8.8.8.8
