{
  "name": "levantdeploy-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@babel/parser": "7.29.9",
    "@babel/types": "7.29.8",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@prisma/client": "6.19.3",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@uiw/react-codemirror": "4.25.12",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "clsx": "2.1.1",
    "dockerode": "4.0.12",
    "fflate": "^0.8.2",
    "geist": "1.7.2",
    "ioredis": "5.8.2",
    "jose": "6.2.12",
    "lucide-react": "0.468.0",
    "next": "15.5.27",
    "nodemailer": "6.10.1",
    "prettier": "3.6.2",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recast": "0.23.21",
    "server-only": "0.0.1",
    "three": "0.185.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/dockerode": "3.3.47",
    "@types/node": "22.18.6",
    "@types/nodemailer": "6.4.20",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.185.4",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
