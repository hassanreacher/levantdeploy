{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noFallthroughCasesInSwitch": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-bdash-build/types/**/*.ts",
    ".next-bdash/types/**/*.ts",
    ".next-bui/types/**/*.ts",
    ".next-landing-dev/types/**/*.ts",
    ".next-landing/types/**/*.ts",
    ".next-llm/types/**/*.ts",
    ".next-plans/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-bcore/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "storage",
    "storage-*",
    "tests/base/compat",
    ".next-*"
  ]
}
